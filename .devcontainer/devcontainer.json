// See https://aka.ms/vscode-remote/devcontainer.json for format details.
{
  "name": "P2-Dual-uSD-FAT32-n-FLASH-FS Development",
  "dockerComposeFile": ["docker-compose.yml", "docker-compose.override.yml"],
  "service": "dev",
  "workspaceFolder": "/workspaces/P2-Dual-uSD-FAT32-n-FLASH-FS",
  "containerEnv": {
    "LANG": "en_US.UTF-8",
    "LC_ALL": "en_US.UTF-8",
    "CLAUDE_CONFIG_DIR": "/home/node/.claude"
  },
  "remoteUser": "node",
  "initializeCommand": "test -f .devcontainer/docker-compose.override.yml || echo 'services: {}' > .devcontainer/docker-compose.override.yml",
  "postCreateCommand": "sudo mkdir -p /Users/stephen && sudo ln -sfn /opt/container-tools /Users/stephen/container-tools; sudo chown -R node:node /home/node/.local 2>/dev/null || true; cat /workspaces/P2-Dual-uSD-FAT32-n-FLASH-FS/.bashrc >> ~/.bashrc; mkdir -p ~/.ssh && cp /tmp/.ssh/* ~/.ssh/ 2>/dev/null; chmod 700 ~/.ssh && chmod 600 ~/.ssh/id_* 2>/dev/null; chmod 644 ~/.ssh/*.pub 2>/dev/null; export PATH=\"$HOME/.local/bin:$PATH\"; claude --update || true;",
  "customizations": {
    "vscode": {
      "extensions": [
        "github.vscode-pull-request-github",
        "eamodio.gitlens",
        "davidanson.vscode-markdownlint",
        "redhat.vscode-yaml"
      ],
      "settings": {
        "files.eol": "\n",
        "editor.tabSize": 4,
        "terminal.integrated.shell.linux": "/bin/bash",
        "files.trimTrailingWhitespace": true
      }
    }
  }
}
