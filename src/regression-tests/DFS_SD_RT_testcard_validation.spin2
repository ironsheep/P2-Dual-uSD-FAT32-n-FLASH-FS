'' =================================================================================================
''
''   File....... DFS_SD_RT_testcard_validation.spin2
''   Purpose.... Validate driver reads a known fixture tree it builds for itself
''   Author..... Stephen M Moraco
''               -- see below for terms of use
''   E-mail..... stephen@ironsheep.biz
''   Started.... JAN 2026
''   Updated.... 23 JUL 2026
''
''   NOTE: This suite is SELF-ESTABLISHING -- it authors the entire fixture tree
''         (byte-for-byte per TestCard/TEST-CARD-SPECIFICATION.md) at startup and
''         removes it at teardown. No card preparation is required; it runs on any
''         freshly-baselined scratch card.
''         See DOCs/Decisions/DECISION-003-TESTCARD-SELF-ESTABLISH.md.
''         TestCard/TESTROOT/ remains the byte-exact reference for these fixtures.
''
'' =================================================================================================

CON

     _CLKFREQ        = 320_000_000
     DEBUG_BAUD      = 2_000_000

     ' Pin configuration for P2 Edge with SD card
     SD_CS   = 60
     SD_MOSI = 59
     SD_MISO = 58
     SD_SCK  = 61

     ' Buffer sizes for various tests
     SMALL_BUF = 64
     MEDIUM_BUF = 512
     LARGE_BUF = 4096

     ' Expected test file sizes (from TEST-CARD-SPECIFICATION.md)
     TINY_FILE_SIZE      = 29
     EXACT512_FILE_SIZE  = 512
     TWOSEC_FILE_SIZE    = 2550
     FOURK_FILE_SIZE     = 4096
     SIXTYK_FILE_SIZE    = 65536
     SEEKTEST_FILE_SIZE  = 2016
     CHECKSUM_FILE_SIZE  = 1024
     LEVEL1_FILE_SIZE    = 54
     DEEP_FILE_SIZE      = 71

     ' Seek test block size
     SEEK_BLOCK_SIZE     = 63      ' Each block in SEEKTEST.BIN is 63 bytes
     SEEK_NUM_BLOCKS     = 32      ' 32 blocks total

     ' Multi directory expected file count
     MULTI_DIR_FILES     = 5

     ' Benchmark parameters
     BENCHMARK_SIZE      = 65536   ' 64KB sequential read
     BENCHMARK_SECTORS   = 128     ' 65536 / 512

     ' --- Fixture establishment (this suite builds everything it reads) ---
     MULTI_FILE_SIZE     = 18      ' "Multi-file test N" + LF
     TWOSEC_LINES        = 50      ' 50 lines of 5x "LINE####--" + LF (51 bytes) = 2550 bytes
     OWNED_ROOT_COUNT    = 9       ' 7 files + LEVEL1 + MULTI, all created here
     FIXTURE_COUNT       = 14      ' 7 root files + 2 nested files + 5 MULTI files
     FIXTURE_TOTAL_BYTES = 78_000  ' ~76KB of fixture data, rounded up for the capacity gate

     ' Pattern selectors for generated binary fixtures
     PAT_FILL_X          = 0       ' every byte 0x58
     PAT_SEQ_BYTE        = 1       ' byte[i] = i & 0xFF
     PAT_XOR_BLOCK       = 2       ' byte[i] = (block << 1) XOR (i & 0xFF)

OBJ
    dfs   : "dual_sd_fat32_flash_fs"
    utils : "DFS_RT_utilities"

DAT

' Test file paths from specification
fileTiny        BYTE    "TINY.TXT", 0
fileExact512    BYTE    "EXACT512.BIN", 0
fileTwoSec      BYTE    "TWOSEC.TXT", 0
fileFourK       BYTE    "FOUR_K.BIN", 0
fileSixtyK      BYTE    "SIXTYFK.BIN", 0
fileSeekTest    BYTE    "SEEKTEST.BIN", 0
fileChecksum    BYTE    "CHECKSUM.BIN", 0
fileLevel1      BYTE    "/LEVEL1/INLEVEL1.TXT", 0
fileDeep        BYTE    "/LEVEL1/LEVEL2/DEEP.TXT", 0
dirMulti        BYTE    "MULTI", 0

' Expected content
tinyContent     BYTE    "TINY TEST FILE", 0    ' First 14 chars of TINY.TXT
level1Content   BYTE    "This file is in LEVEL1", 0  ' First 22 chars
deepContent     BYTE    "Deepest level", 0     ' First 13 chars

' --- Fixture establishment: names and byte-exact content ---
' Directory names (created in the current directory, per newDirectory()'s contract)
dirLevel1       BYTE    "LEVEL1", 0
dirLevel2       BYTE    "LEVEL2", 0
rootPath        BYTE    "/", 0
parentPath      BYTE    "..", 0

' Bare names used while the cwd is the owning directory
nameInLevel1    BYTE    "INLEVEL1.TXT", 0
nameDeep        BYTE    "DEEP.TXT", 0
multiFile1      BYTE    "FILE1.TXT", 0
multiFile2      BYTE    "FILE2.TXT", 0
multiFile3      BYTE    "FILE3.TXT", 0
multiFile4      BYTE    "FILE4.TXT", 0
multiFile5      BYTE    "FILE5.TXT", 0
multiNames      LONG    @multiFile1, @multiFile2, @multiFile3, @multiFile4, @multiFile5

' Full file bodies (sizes must match the *_FILE_SIZE constants above)
tinyFull        BYTE    "TINY TEST FILE - 32 BYTES OK!", 0                                  ' 29, no newline
level1Full      BYTE    "This file is in LEVEL1 subdirectory for path testing.", 10, 0      ' 54
deepFull        BYTE    "Deepest level - LEVEL2 directory test file for nested path resolution.", 10, 0   ' 71
multiPrefix     BYTE    "Multi-file test ", 0                                               ' + digit + LF = 18
lineTag         BYTE    "LINE", 0
seekTag         BYTE    "BLK", 0

' Root-level entries this suite owns -- 0-terminated, for ensureCleanBaseline and the
' enumeration check. Order matches the enumeration test's expectations.
ownedRootNames  LONG    @fileTiny, @fileExact512, @fileTwoSec, @fileFourK, @fileSixtyK, @fileSeekTest, @fileChecksum, @dirLevel1, @dirMulti, 0

' Buffers
smallBuf        BYTE    0[SMALL_BUF]
mediumBuf       BYTE    0[MEDIUM_BUF]

PUB go() | workerCog, result
'' Validate SD fixture-tree operations against a tree this suite builds itself.
''
' @local workerCog - Driver worker cog ID
' @local result - Test result value

    debug(" ")
    debug("==============================================")
    debug("  Dual FS (SD) - Test Card Validation")
    debug("  (Self-establishing fixture tree)")
    debug("==============================================")
    debug(" ")

    ' Initialize worker cog
    workerCog := dfs.init()

    ' Mount the card
    result := dfs.mount(dfs.DEV_SD)
    if result <> dfs.SUCCESS
        debug("ERROR: Could not mount SD card!")
        debug("Is the test card inserted?")
    else
        ' Show card info
        debug(" ")
        debug("* SD Card Information:")
        debug("   Volume Label: ", zstr_(dfs.volumeLabel(dfs.DEV_SD)))
        debug("   Free Space: ", udec(dfs.freeSpace(dfs.DEV_SD)), " sectors")

        ' Build the fixture tree this suite reads. On a baselined card a failure here
        ' is a real defect, so it is reported as a hard precondition, never a silent skip.
        if establishFixtures()
            ' Run all validation tests
            test_mount_validation()
            test_root_directory_enum()
            test_tiny_file()
            test_exact_sector()
            test_four_k_pattern()
            test_multi_sector_text()
            test_large_file_cluster_chain()
            test_seek_operations()
            test_checksum_integrity()
            test_path_resolution()
            test_deep_path()
            test_directory_navigation()
            test_benchmark_sequential()

        ' Leave the card as we found it (idempotent, and audits its own work)
        teardownFixtures()

        ' Unmount
        dfs.unmount(dfs.DEV_SD)

    ' Summary
    dfs.stop()

    utils.ShowTestEndCounts()

    debug(" ")
    debug("* Test Card Validation Complete")
    debug("END_SESSION")


PRI test_mount_validation() | pLabel
    utils.startTestGroup(@"Test 1: Mount Validation")

    utils.startTest(@"Card mounted successfully")
    pLabel := dfs.volumeLabel(dfs.DEV_SD)
    utils.evaluateNotZero(pLabel, @"volumeLabel() not null")

    utils.startTest(@"Free space is reasonable")
    utils.evaluateRange(dfs.freeSpace(dfs.DEV_SD), @"freeSpace()", 1, $7FFF_FFFF)


PRI test_root_directory_enum() | count, idx, pEntry, oIdx, pName
    utils.startTestGroup(@"Test 2: Root Directory Enumeration")

    utils.startTest(@"Enumerate root directory entries")
    count := 0
    idx := 0
    repeat
        pEntry := dfs.readDirectory(idx)
        if pEntry == 0
            quit
        debug("  Entry ", udec_(idx), ": ", zstr_(dfs.fileName()))
        count++
        idx++

    ' The root holds at least what this suite created. An exact total would couple the
    ' result to whatever any other suite left behind; every OWNED entry being present is
    ' the property self-establishment actually guarantees -- checked one by one below.
    utils.evaluateBool(count >= OWNED_ROOT_COUNT, @"root holds all owned entries", TRUE)

    utils.startTest(@"Each owned root entry is enumerated")
    utils.setCheckCountPerTest(OWNED_ROOT_COUNT)
    repeat oIdx from 0 to OWNED_ROOT_COUNT - 1
        pName := LONG[@ownedRootNames][oIdx]
        utils.evaluateSubBool(rootEntryPresent(pName), @"owned entry enumerated", TRUE)


PRI rootEntryPresent(pName) : bFound | idx, pEntry
' Scan the root enumeration for one owned entry by name.
'
' @param pName - pointer to the 8.3 name to look for
' @returns bFound - TRUE if the enumeration reports it
' @local idx - enumeration index
' @local pEntry - directory entry pointer

    bFound := false
    idx := 0
    repeat
        pEntry := dfs.readDirectory(idx)
        if pEntry == 0
            quit
        if strcomp(dfs.fileName(), pName)
            bFound := true
            quit
        idx++


PRI test_tiny_file() | fileSize, bytesRead, handle
    utils.startTestGroup(@"Test 3: Small File Read (TINY.TXT)")

    utils.startTest(@"Open TINY.TXT")
    handle := dfs.openFileRead(dfs.DEV_SD, @fileTiny)
    utils.evaluateBool(handle >= 0, @"openFileRead()", true)

    utils.startTest(@"Verify file size is 29 bytes")
    fileSize := dfs.fileSizeHandle(handle)
    utils.evaluateSingleValue(fileSize, @"fileSize()", TINY_FILE_SIZE)

    utils.startTest(@"Read and verify content starts correctly")
    bytesRead := dfs.readHandle(handle, @smallBuf, 14)
    smallBuf[14] := 0  ' null terminate for comparison
    utils.evaluateStringMatch(@smallBuf, @"content start", @tinyContent)

    utils.startTest(@"Verify first byte is 'T' (0x54)")
    dfs.seekHandle(handle, 0)
    bytesRead := dfs.readHandle(handle, @smallBuf, 1)
    utils.evaluateSingleValueHex(smallBuf[0], @"first byte", $54)

    dfs.closeFileHandle(handle)


PRI test_exact_sector() | result, i, allMatch, handle
    utils.startTestGroup(@"Test 4: Exact Sector Boundary (EXACT512.BIN)")

    utils.startTest(@"Open EXACT512.BIN")
    handle := dfs.openFileRead(dfs.DEV_SD, @fileExact512)
    utils.evaluateBool(handle >= 0, @"openFileRead()", true)

    utils.startTest(@"Verify file size is exactly 512 bytes")
    utils.evaluateSingleValue(dfs.fileSizeHandle(handle), @"fileSize()", EXACT512_FILE_SIZE)

    utils.startTest(@"Read 512 bytes")
    result := dfs.readHandle(handle, @mediumBuf, MEDIUM_BUF)
    utils.evaluateSingleValue(result, @"bytes read", EXACT512_FILE_SIZE)

    utils.startTest(@"Verify all bytes are 0x58 ('X')")
    allMatch := true
    repeat i from 0 to MEDIUM_BUF - 1
        if mediumBuf[i] <> $58
            debug("  Mismatch at ", udec_(i), ": got $", uhex_(mediumBuf[i]))
            allMatch := false
            quit
    utils.evaluateBool(allMatch, @"all bytes = 0x58", true)

    dfs.closeFileHandle(handle)


PRI test_four_k_pattern() | result, i, expected, allMatch, handle
    utils.startTestGroup(@"Test 5: Multi-Sector Pattern (FOUR_K.BIN)")

    utils.startTest(@"Open FOUR_K.BIN")
    handle := dfs.openFileRead(dfs.DEV_SD, @fileFourK)
    utils.evaluateBool(handle >= 0, @"openFileRead()", true)

    utils.startTest(@"Verify file size is 4096 bytes")
    utils.evaluateSingleValue(dfs.fileSizeHandle(handle), @"fileSize()", FOURK_FILE_SIZE)

    utils.startTest(@"Read and verify sequential pattern")
    allMatch := true

    ' Read in chunks and verify pattern: byte[i] = i & 0xFF
    repeat i from 0 to 7  ' 8 sectors
        dfs.readHandle(handle, @mediumBuf, MEDIUM_BUF)
        repeat result from 0 to MEDIUM_BUF - 1
            expected := ((i * MEDIUM_BUF) + result) & $FF
            if mediumBuf[result] <> expected
                debug("  Mismatch at ", udec_((i * MEDIUM_BUF) + result), ": got $", uhex_(mediumBuf[result]), " expected $", uhex_(expected))
                allMatch := false
                quit
        if not allMatch
            quit

    utils.evaluateBool(allMatch, @"pattern match", true)

    dfs.closeFileHandle(handle)


PRI test_multi_sector_text() | fileSize, handle
    utils.startTestGroup(@"Test 6: Multi-Sector Text (TWOSEC.TXT)")

    utils.startTest(@"Open TWOSEC.TXT")
    handle := dfs.openFileRead(dfs.DEV_SD, @fileTwoSec)
    utils.evaluateBool(handle >= 0, @"openFileRead()", true)

    utils.startTest(@"Verify file size is 2550 bytes")
    fileSize := dfs.fileSizeHandle(handle)
    utils.evaluateSingleValue(fileSize, @"fileSize()", TWOSEC_FILE_SIZE)

    utils.startTest(@"Read first line - should start with LINE0001")
    dfs.readHandle(handle, @smallBuf, 8)
    smallBuf[8] := 0
    utils.evaluateStringMatch(@smallBuf, @"first 8 bytes", @"LINE0001")

    dfs.closeFileHandle(handle)


PRI test_large_file_cluster_chain() | fileSize, pos, expected, handle
    utils.startTestGroup(@"Test 7: Multi-Cluster File (SIXTYFK.BIN)")

    utils.startTest(@"Open SIXTYFK.BIN")
    handle := dfs.openFileRead(dfs.DEV_SD, @fileSixtyK)
    utils.evaluateBool(handle >= 0, @"openFileRead()", true)

    utils.startTest(@"Verify file size is 65536 bytes")
    fileSize := dfs.fileSizeHandle(handle)
    utils.evaluateSingleValue(fileSize, @"fileSize()", SIXTYK_FILE_SIZE)

    utils.startTest(@"Verify pattern at various positions")
    utils.setCheckCountPerTest(8)

    ' Pattern: byte[i] = (block << 1) XOR (i & 0xFF) where block = i / 512
    repeat pos from 0 to SIXTYK_FILE_SIZE - 1 step 8192  ' Check every 8KB
        dfs.seekHandle(handle, pos)
        dfs.readHandle(handle, @smallBuf, 1)
        expected := ((pos / MEDIUM_BUF) << 1) ^ (pos & $FF)
        utils.evaluateSubValueHex(smallBuf[0], @"pattern byte", expected)

    dfs.closeFileHandle(handle)


PRI test_seek_operations() | handle
    utils.startTestGroup(@"Test 8: Seek Operations (SEEKTEST.BIN)")

    utils.startTest(@"Open SEEKTEST.BIN")
    handle := dfs.openFileRead(dfs.DEV_SD, @fileSeekTest)
    utils.evaluateBool(handle >= 0, @"openFileRead()", true)

    utils.startTest(@"Verify file size is 2016 bytes")
    utils.evaluateSingleValue(dfs.fileSizeHandle(handle), @"fileSize()", SEEKTEST_FILE_SIZE)

    ' File has 32 blocks of 63 bytes each: "BLK##---" + 55 bytes of 0x55
    utils.startTest(@"Seek to block 0 (offset 0)")
    dfs.seekHandle(handle, 0 * SEEK_BLOCK_SIZE)
    dfs.readHandle(handle, @smallBuf, 8)
    smallBuf[8] := 0
    utils.evaluateStringMatch(@smallBuf, @"block 0 header", @"BLK00---")

    utils.startTest(@"Seek to block 1 (offset 63)")
    dfs.seekHandle(handle, 1 * SEEK_BLOCK_SIZE)
    dfs.readHandle(handle, @smallBuf, 8)
    smallBuf[8] := 0
    utils.evaluateStringMatch(@smallBuf, @"block 1 header", @"BLK01---")

    utils.startTest(@"Seek to block 10 (offset 630)")
    dfs.seekHandle(handle, 10 * SEEK_BLOCK_SIZE)
    dfs.readHandle(handle, @smallBuf, 8)
    smallBuf[8] := 0
    utils.evaluateStringMatch(@smallBuf, @"block 10 header", @"BLK10---")

    utils.startTest(@"Seek to block 31 (offset 1953)")
    dfs.seekHandle(handle, (SEEK_NUM_BLOCKS - 1) * SEEK_BLOCK_SIZE)
    dfs.readHandle(handle, @smallBuf, 8)
    smallBuf[8] := 0
    utils.evaluateStringMatch(@smallBuf, @"block 31 header", @"BLK31---")

    dfs.closeFileHandle(handle)


PRI test_checksum_integrity() | i, sum, handle
    utils.startTestGroup(@"Test 9: Checksum Verification (CHECKSUM.BIN)")

    utils.startTest(@"Open CHECKSUM.BIN")
    handle := dfs.openFileRead(dfs.DEV_SD, @fileChecksum)
    utils.evaluateBool(handle >= 0, @"openFileRead()", true)

    utils.startTest(@"Verify file size is 1024 bytes")
    utils.evaluateSingleValue(dfs.fileSizeHandle(handle), @"fileSize()", CHECKSUM_FILE_SIZE)

    utils.startTest(@"Read and calculate checksum")
    ' Read in two chunks since buffer is 512
    sum := 0
    dfs.readHandle(handle, @mediumBuf, MEDIUM_BUF)
    repeat i from 0 to MEDIUM_BUF - 1
        sum += mediumBuf[i]
    dfs.readHandle(handle, @mediumBuf, MEDIUM_BUF)
    repeat i from 0 to MEDIUM_BUF - 1
        sum += mediumBuf[i]

    ' Expected sum: 130560 (bytes 0-255 repeated 4 times: 4 * (0+1+2+...+255) = 4 * 32640)
    utils.evaluateSingleValue(sum, @"checksum", 130560)

    dfs.closeFileHandle(handle)


PRI test_path_resolution() | fileSize, handle
    utils.startTestGroup(@"Test 10: Subdirectory Path Resolution")

    utils.startTest(@"Open /LEVEL1/INLEVEL1.TXT with absolute path")
    handle := dfs.openFileRead(dfs.DEV_SD, @fileLevel1)
    utils.evaluateBool(handle >= 0, @"openFileRead()", true)

    utils.startTest(@"Verify file size is 54 bytes")
    fileSize := dfs.fileSizeHandle(handle)
    utils.evaluateSingleValue(fileSize, @"fileSize()", LEVEL1_FILE_SIZE)

    utils.startTest(@"Verify content starts correctly")
    dfs.readHandle(handle, @smallBuf, 22)
    smallBuf[22] := 0
    utils.evaluateStringMatch(@smallBuf, @"content start", @level1Content)

    dfs.closeFileHandle(handle)


PRI test_deep_path() | fileSize, handle
    utils.startTestGroup(@"Test 11: Deep Nested Path")

    utils.startTest(@"Open /LEVEL1/LEVEL2/DEEP.TXT")
    handle := dfs.openFileRead(dfs.DEV_SD, @fileDeep)
    utils.evaluateBool(handle >= 0, @"openFileRead()", true)

    utils.startTest(@"Verify file size is 71 bytes")
    fileSize := dfs.fileSizeHandle(handle)
    utils.evaluateSingleValue(fileSize, @"fileSize()", DEEP_FILE_SIZE)

    utils.startTest(@"Verify content starts correctly")
    dfs.readHandle(handle, @smallBuf, 13)
    smallBuf[13] := 0
    utils.evaluateStringMatch(@smallBuf, @"content start", @deepContent)

    dfs.closeFileHandle(handle)


PRI test_directory_navigation() | status, count, idx, pEntry
    utils.startTestGroup(@"Test 12: Directory Navigation (MULTI)")

    utils.startTest(@"Change to MULTI directory")
    status := dfs.changeDirectory(dfs.DEV_SD, @dirMulti)
    utils.evaluateSingleValue(status, @"changeDirectory()", dfs.SUCCESS)

    utils.startTest(@"Enumerate files in MULTI - expect 5")
    count := 0
    idx := 0
    repeat
        pEntry := dfs.readDirectory(idx)
        if pEntry == 0
            quit
        debug("  File: ", zstr_(dfs.fileName()))
        count++
        idx++

    utils.evaluateSingleValue(count, @"file count", MULTI_DIR_FILES)

    utils.startTest(@"Navigate back to root")
    status := dfs.changeDirectory(dfs.DEV_SD, @"/")
    utils.evaluateSingleValue(status, @"changeDirectory(/)", dfs.SUCCESS)


PRI test_benchmark_sequential() | start, elapsed, i, bytesPerSec, handle
    utils.startTestGroup(@"Performance Benchmark")

    utils.startTest(@"Sequential read 64KB - timing")
    handle := dfs.openFileRead(dfs.DEV_SD, @fileSixtyK)

    start := getct()
    repeat i from 0 to BENCHMARK_SECTORS - 1
        dfs.readHandle(handle, @mediumBuf, MEDIUM_BUF)
    elapsed := getct() - start

    dfs.closeFileHandle(handle)

    ' Calculate throughput
    ' elapsed is in clock ticks, convert to microseconds then to bytes/sec
    bytesPerSec := (BENCHMARK_SIZE * (clkfreq / 1000)) / (elapsed / 1000)

    debug("  64KB read time: ", udec_(elapsed / (clkfreq / 1000000)), " microseconds")
    debug("  Throughput: ~", udec_(bytesPerSec / 1024), " KB/sec")
    utils.evaluateBool(elapsed > 0, @"benchmark complete", true)


' ===============================================================================
' FIXTURE ESTABLISHMENT -- this suite authors every byte it later reads
' Content is byte-for-byte per TestCard/TEST-CARD-SPECIFICATION.md; see
' DOCs/Decisions/DECISION-003-TESTCARD-SELF-ESTABLISH.md for why it self-establishes.
' ===============================================================================

PRI establishFixtures() : bReady | builtCount
' Build the whole fixture tree from a baselined card.
'
' @returns bReady - TRUE if every fixture exists and the tests may run
' @local builtCount - number of fixtures successfully created

    bReady := utils.assertFreeSpace(dfs.DEV_SD, utils.clustersForBytes(dfs.DEV_SD, FIXTURE_TOTAL_BYTES), @"test-card fixture tree (~76KB)")
    ifnot bReady
        return

    teardownFixtures()                                   ' idempotent: start from a known-empty tree

    debug("* Establishing fixture tree...")
    builtCount := 0
    if makeLiteralFile(@fileTiny, @tinyFull, TINY_FILE_SIZE)
        builtCount++
    if makePatternFile(@fileExact512, EXACT512_FILE_SIZE, PAT_FILL_X)
        builtCount++
    if makeTwoSecFile()
        builtCount++
    if makePatternFile(@fileFourK, FOURK_FILE_SIZE, PAT_SEQ_BYTE)
        builtCount++
    if makePatternFile(@fileSixtyK, SIXTYK_FILE_SIZE, PAT_XOR_BLOCK)
        builtCount++
    if makeSeekFile()
        builtCount++
    if makePatternFile(@fileChecksum, CHECKSUM_FILE_SIZE, PAT_SEQ_BYTE)
        builtCount++
    builtCount += makeNestedTree()                       ' LEVEL1/, LEVEL1/LEVEL2/ (2 files)
    builtCount += makeMultiDir()                         ' MULTI/ (5 files)

    ' One hard precondition covers the whole tree: on a card the runner just baselined,
    ' a fixture that will not build is a driver defect, not a setup excuse.
    bReady := utils.assertPrecondition(builtCount == FIXTURE_COUNT, @"test-card fixture tree established")


PRI teardownFixtures() | idx
' Remove the fixture tree, innermost first, then audit the owned root entries.
'
' @local idx - loop index over the MULTI file names

    if dfs.changeDirectory(dfs.DEV_SD, @dirMulti) == dfs.SUCCESS
        repeat idx from 0 to MULTI_DIR_FILES - 1
            dfs.deleteFile(dfs.DEV_SD, LONG[@multiNames][idx])
        dfs.changeDirectory(dfs.DEV_SD, @rootPath)

    if dfs.changeDirectory(dfs.DEV_SD, @dirLevel1) == dfs.SUCCESS
        if dfs.changeDirectory(dfs.DEV_SD, @dirLevel2) == dfs.SUCCESS
            dfs.deleteFile(dfs.DEV_SD, @nameDeep)
            dfs.changeDirectory(dfs.DEV_SD, @parentPath)
        dfs.deleteFile(dfs.DEV_SD, @nameInLevel1)
        dfs.deleteFile(dfs.DEV_SD, @dirLevel2)
        dfs.changeDirectory(dfs.DEV_SD, @rootPath)

    ' Deletes the owned root entries (files + the now-empty LEVEL1 and MULTI) and audits
    ' that none survived -- a stuck leftover reports as setup-not-met, never as a test failure.
    utils.ensureCleanBaseline(dfs.DEV_SD, @ownedRootNames)


PRI makeLiteralFile(pName, pContent, sizeBytes) : bOk | handle
' Create a file whose content is a literal string of known length.
'
' @param pName - filename (bare name; created in the current directory)
' @param pContent - pointer to the content bytes
' @param sizeBytes - exact byte count to write
' @returns bOk - TRUE if created and fully written
' @local handle - file handle

    handle := dfs.createFileNew(dfs.DEV_SD, pName)
    bOk := (handle >= 0)
    if bOk
        bOk := (dfs.writeHandle(handle, pContent, sizeBytes) == sizeBytes)
        dfs.closeFileHandle(handle)
    ifnot bOk
        debug("  # fixture FAILED: ", zstr_(pName))


PRI makePatternFile(pName, sizeBytes, pattern) : bOk | handle, chunk, chunks
' Create a binary fixture whose content is generated 512 bytes at a time.
'
' @param pName - filename
' @param sizeBytes - total size (an exact multiple of MEDIUM_BUF)
' @param pattern - PAT_FILL_X, PAT_SEQ_BYTE, or PAT_XOR_BLOCK
' @returns bOk - TRUE if created and fully written
' @local handle - file handle
' @local chunk - current 512-byte block index
' @local chunks - total block count

    handle := dfs.createFileNew(dfs.DEV_SD, pName)
    bOk := (handle >= 0)
    if bOk
        chunks := sizeBytes / MEDIUM_BUF
        repeat chunk from 0 to chunks - 1
            fillPatternChunk(pattern, chunk)
            if dfs.writeHandle(handle, @mediumBuf, MEDIUM_BUF) <> MEDIUM_BUF
                bOk := false
                quit
        dfs.closeFileHandle(handle)
    ifnot bOk
        debug("  # fixture FAILED: ", zstr_(pName))


PRI fillPatternChunk(pattern, chunk) | idx
' Fill mediumBuf with one 512-byte block of the requested pattern.
'
' @param pattern - PAT_FILL_X, PAT_SEQ_BYTE, or PAT_XOR_BLOCK
' @param chunk - block index (only PAT_XOR_BLOCK varies by block)
' @local idx - byte offset within the block

    if pattern == PAT_FILL_X
        bytefill(@mediumBuf, $58, MEDIUM_BUF)
    elseif pattern == PAT_SEQ_BYTE
        repeat idx from 0 to MEDIUM_BUF - 1
            mediumBuf[idx] := idx & $FF
    else
        repeat idx from 0 to MEDIUM_BUF - 1
            mediumBuf[idx] := ((chunk << 1) ^ (idx & $FF)) & $FF


PRI makeTwoSecFile() : bOk | handle, lineNo, segIdx, pos
' Create TWOSEC.TXT: 50 lines of 5x "LINE####--" plus a newline (51 bytes each).
'
' @returns bOk - TRUE if created and fully written
' @local handle - file handle
' @local lineNo - 1-based line number
' @local segIdx - repetition within the line
' @local pos - write offset in smallBuf

    handle := dfs.createFileNew(dfs.DEV_SD, @fileTwoSec)
    bOk := (handle >= 0)
    if bOk
        repeat lineNo from 1 to TWOSEC_LINES
            pos := 0
            repeat segIdx from 0 to 4
                bytemove(@smallBuf + pos, @lineTag, 4)
                smallBuf[pos + 4] := "0" + (lineNo / 1000)
                smallBuf[pos + 5] := "0" + ((lineNo / 100) // 10)
                smallBuf[pos + 6] := "0" + ((lineNo / 10) // 10)
                smallBuf[pos + 7] := "0" + (lineNo // 10)
                smallBuf[pos + 8] := "-"
                smallBuf[pos + 9] := "-"
                pos += 10
            smallBuf[pos++] := 10
            if dfs.writeHandle(handle, @smallBuf, pos) <> pos
                bOk := false
                quit
        dfs.closeFileHandle(handle)
    ifnot bOk
        debug("  # fixture FAILED: ", zstr_(@fileTwoSec))


PRI makeSeekFile() : bOk | handle, blk
' Create SEEKTEST.BIN: 32 blocks of "BLK##---" followed by 55 bytes of 0x55.
'
' @returns bOk - TRUE if created and fully written
' @local handle - file handle
' @local blk - block index 0..31

    handle := dfs.createFileNew(dfs.DEV_SD, @fileSeekTest)
    bOk := (handle >= 0)
    if bOk
        repeat blk from 0 to SEEK_NUM_BLOCKS - 1
            bytemove(@smallBuf, @seekTag, 3)
            smallBuf[3] := "0" + (blk / 10)
            smallBuf[4] := "0" + (blk // 10)
            smallBuf[5] := "-"
            smallBuf[6] := "-"
            smallBuf[7] := "-"
            bytefill(@smallBuf + 8, $55, SEEK_BLOCK_SIZE - 8)
            if dfs.writeHandle(handle, @smallBuf, SEEK_BLOCK_SIZE) <> SEEK_BLOCK_SIZE
                bOk := false
                quit
        dfs.closeFileHandle(handle)
    ifnot bOk
        debug("  # fixture FAILED: ", zstr_(@fileSeekTest))


PRI makeNestedTree() : builtCount
' Create LEVEL1/INLEVEL1.TXT and LEVEL1/LEVEL2/DEEP.TXT, returning to root either way.
'
' @returns builtCount - number of files successfully created (0..2)

    builtCount := 0
    if dfs.newDirectory(dfs.DEV_SD, @dirLevel1) == dfs.SUCCESS
        if dfs.changeDirectory(dfs.DEV_SD, @dirLevel1) == dfs.SUCCESS
            if makeLiteralFile(@nameInLevel1, @level1Full, LEVEL1_FILE_SIZE)
                builtCount++
            if dfs.newDirectory(dfs.DEV_SD, @dirLevel2) == dfs.SUCCESS
                if dfs.changeDirectory(dfs.DEV_SD, @dirLevel2) == dfs.SUCCESS
                    if makeLiteralFile(@nameDeep, @deepFull, DEEP_FILE_SIZE)
                        builtCount++
                    dfs.changeDirectory(dfs.DEV_SD, @parentPath)
    dfs.changeDirectory(dfs.DEV_SD, @rootPath)


PRI makeMultiDir() : builtCount | idx
' Create MULTI/ and its five 18-byte files, returning to root either way.
'
' @returns builtCount - number of files successfully created (0..5)
' @local idx - 0-based file index

    builtCount := 0
    if dfs.newDirectory(dfs.DEV_SD, @dirMulti) == dfs.SUCCESS
        if dfs.changeDirectory(dfs.DEV_SD, @dirMulti) == dfs.SUCCESS
            repeat idx from 0 to MULTI_DIR_FILES - 1
                bytemove(@smallBuf, @multiPrefix, 16)
                smallBuf[16] := "1" + idx
                smallBuf[17] := 10
                if makeLiteralFile(LONG[@multiNames][idx], @smallBuf, MULTI_FILE_SIZE)
                    builtCount++
    dfs.changeDirectory(dfs.DEV_SD, @rootPath)


